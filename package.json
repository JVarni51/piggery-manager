{
  "name": "herdkeep",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --port 4457",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export -p web && node scripts/clean-export.js",
    "typecheck": "tsc --noEmit",
